# Ignore macOS system files
.DS_Store

# Ignore python cache files
__pycache__/
*.pyc

# Ignore Original Paper Archive
Original Paper Archive/

# Ignore all data files globally (including CSVs, spreadsheets, compressed archives, pickles)
*.csv
*.tsv
*.xlsx
*.xls
*.zip
*.tar.gz
*.rar
*.pkl
*.h5
*.parquet
*.feather

# Exclude .gitkeep files to keep empty directory structure in git if necessary
!**/.gitkeep

